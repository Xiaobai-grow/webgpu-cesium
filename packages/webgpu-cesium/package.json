{
  "name": "@webgpu-cesium/webgpu-cesium",
  "version": "0.0.0",
  "description": "聚合包：re-export 全部 @webgpu-cesium/* 包，便于 CDN 与快速上手",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webgpu-cesium/core": "workspace:*",
    "@webgpu-cesium/renderer": "workspace:*",
    "@webgpu-cesium/rhi": "workspace:*",
    "@webgpu-cesium/scene": "workspace:*",
    "@webgpu-cesium/shaders": "workspace:*",
    "@webgpu-cesium/widgets": "workspace:*"
  }
}
